{
  "name": "cemu",
  "version-string": "1.0",
  "dependencies": [
    "pugixml",
    "zlib",
    "zstd",
    {
      "name": "libzip",
      "default-features": false
    },
    "rapidjson",
    {
      "name": "sdl3",
      "default-features": false
    },
    "boost-tokenizer",
    "boost-container",
    "boost-context",
    "boost-iostreams",
    "boost-program-options",
    "boost-nowide",
    "boost-algorithm",
    "boost-functional",
    "boost-optional",
    "boost-signals2",
    "boost-asio",
    "boost-ptr-container",
    "boost-property-tree",
    "boost-static-string",
    "boost-random",
    "fmt",
    "libpng",
    "glm",
    {
      "name": "glslang",
      "default-features": false
    },
    "zstd",
    {
      "name": "wxwidgets",
      "default-features": false,
      "features": [
        "debug-support"
      ],
      "platform": "!android"
    },
    "openssl",
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "openssl"
      ]
    },
    {
      "name": "dbus",
      "default-features": false,
      "platform": "linux"
    },
    {
      "name": "tiff",
      "default-features": false,
      "features": [
        "jpeg",
        "zip"
      ]
    },
    "libusb"
  ]
}
